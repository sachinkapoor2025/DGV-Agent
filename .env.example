# DGV AI Business OS — copy to .env.local (never commit secrets)

DGV_AUTH_SECRET=change-me
DGV_ADMIN_EMAIL=divit@dgv.local
DGV_ADMIN_PASSWORD=change-me
DGV_CRON_SECRET=change-me

# AI provider: cursor (default) | openai | anthropic
DGV_AI_PROVIDER=cursor
# Optional only for headless cloud workers (not required while using Cursor):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# MyDGV server-to-server (preferred after deploying feature/dgv-ai-os-integration)
MYDGV_API_URL=https://z0nrgtv865.execute-api.ap-south-1.amazonaws.com/prod
MYDGV_DGV_OS_API_KEY=

